# MCP tool credentials (for skill-forge's supplementary data sources)
# Copy this file to .env (in the same directory) and fill in your real values.
# .env is gitignored — never commit real tokens.

# --- CodeHub (Data Source 2, part B) — Huawei internal Git platform ---
# Get a CODEHUB_TOKEN from CodeHub → Settings → Access Tokens.
# CODEHUB_HOST is the CodeHub instance your token is valid for. codehub-g.huawei.com
# is the directly-reachable host from most Huawei networks; codehub-y.huawei.com
# may require a different network segment. Confirm reachability with:
#   NO_PROXY=*.huawei.com curl -sS -o /dev/null -w "%{http_code}\n" https://codehub-g.huawei.com/
CODEHUB_TOKEN=your_codehub_personal_access_token_here
CODEHUB_HOST=https://codehub-g.huawei.com/

# --- GitHub (Data Source 2, part C) — external Git platform ---
# Get a GitHub PAT from github.com/settings/tokens (repo scope minimum).
# This tool routes THROUGH the corporate proxy (external host), unlike
# the CodeHub tool which bypasses it (intranet host).
GITHUB_TOKEN=your_github_personal_access_token_here
