# CodeHub MCP server credentials (for huawei-auto-evolve's Data Source 2, part B)
# Copy this file to .env (in the same directory) and fill in your real values.
# .env is gitignored — never commit real tokens.
#
# Get a PRIVATE_TOKEN from CodeHub → Settings → Access Tokens.
# WEB_HOST is the CodeHub instance your token is valid for. codehub-g.huawei.com
# is the directly-reachable host from most Huawei networks; codehub-y.huawei.com
# may require a different network segment. Confirm reachability with:
#   NO_PROXY=*.huawei.com curl -sS -o /dev/null -w "%{http_code}\n" https://codehub-g.huawei.com/

PRIVATE_TOKEN=your_codehub_personal_access_token_here
WEB_HOST=https://codehub-g.huawei.com/
